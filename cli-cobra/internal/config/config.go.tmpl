package config

import (
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"

	"github.com/spf13/viper"
)

// Load wires Viper's env, replacer and prefix, then reads the config file
// (when one is found). A missing config file is not an error — flags and
// environment variables alone must be enough to run the CLI.
func Load(cfgFile string) error {
	viper.SetEnvPrefix("{{ .Name | snake | upper }}")
	viper.SetEnvKeyReplacer(strings.NewReplacer(".", "_", "-", "_"))
	viper.AutomaticEnv()

	if cfgFile != "" {
		viper.SetConfigFile(cfgFile)
		if err := viper.ReadInConfig(); err != nil {
			return fmt.Errorf("reading config %q: %w", cfgFile, err)
		}

		return nil
	}

	viper.SetConfigName("config")
	viper.SetConfigType("toml")
	if home, err := os.UserHomeDir(); err == nil {
		viper.AddConfigPath(filepath.Join(home, ".{{.Name}}"))
	}
	viper.AddConfigPath(".")
	viper.AddConfigPath("./configs")

	if err := viper.ReadInConfig(); err != nil {
		if _, ok := errors.AsType[viper.ConfigFileNotFoundError](err); !ok {
			return fmt.Errorf("reading config: %w", err)
		}
	}

	// Load environment-specific override (e.g. configs/config_development.toml).
	// Keys present in the overlay overwrite the base config.
	// A missing overlay file is silently ignored.
	if env := viper.GetString("env"); env != "" {
		viper.SetConfigName("config_" + env)
		if err := viper.MergeInConfig(); err != nil {
			if _, ok := errors.AsType[viper.ConfigFileNotFoundError](err); !ok {
				return fmt.Errorf("merging %q config: %w", env, err)
			}
		}
	}

	return nil
}
