package version

import (
	"fmt"
	"runtime"
	"runtime/debug"
	"strings"

	"github.com/spf13/cobra"
)

const defaultVersion = "none"

// Version, Commit and BuildDate are injected at build time via -ldflags.
// When unset (e.g. `go install`), they fall back to runtime/debug build info.
var (
	Version   = defaultVersion
	Commit    = ""
	BuildDate = ""
)

const name = "{{.Name}}"

type vcs struct {
	revision, time string
	dirty          bool
}

func buildInfo() string {
	v := readVCS()

	revision := Commit
	if revision == "" {
		revision = v.revision
	}

	buildTime := BuildDate
	if buildTime == "" {
		buildTime = v.time
	}

	var b strings.Builder
	fmt.Fprintf(&b, "Name: %s\n", name)
	fmt.Fprintf(&b, "Version: %s\n", Version)
	fmt.Fprintf(&b, "OS/Arch: %s/%s\n", runtime.GOOS, runtime.GOARCH)
	if revision != "" {
		dirty := ""
		if v.dirty {
			dirty = "-dirty"
		}
		fmt.Fprintf(&b, "Revision: %s%s\n", revision, dirty)
	}
	if buildTime != "" {
		fmt.Fprintf(&b, "Built at: %s\n", buildTime)
	}

	return b.String()
}

func readVCS() vcs {
	dinfo, ok := debug.ReadBuildInfo()
	if !ok {
		return vcs{}
	}

	var out vcs

	for _, s := range dinfo.Settings {
		switch s.Key {
		case "vcs.revision":
			out.revision = s.Value
		case "vcs.time":
			out.time = s.Value
		case "vcs.modified":
			out.dirty = s.Value == "true"
		}
	}

	return out
}

func NewCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "version",
		Short: "Print version information",
		Args:  cobra.NoArgs,
		RunE: func(cmd *cobra.Command, _ []string) error {
			if _, err := fmt.Fprint(cmd.OutOrStdout(), buildInfo()); err != nil {
				return fmt.Errorf("writing version: %w", err)
			}

			return nil
		},
	}
}
